{
  "name": "vaultual",
  "displayName": "Vaultual",
  "publisher": "ryanbalsdon",
  "description": "Edit password-encrypted tar archives directly in VS Code.",
  "version": "1.0.2",
  "icon": "assets/icon.png",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.146.0",
    "node": ">=26"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onFileSystem:vaultual"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "vaultual.mountArchive",
        "title": "Mount Archive",
        "category": "Vaultual"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "vaultual.mountArchive",
          "when": "resourceScheme == file && resourceFilename =~ /\\.(tar|tar\\.gz|tgz|gpg|pgp|asc)$/i",
          "group": "navigation@10"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run check && node esbuild.mjs --production",
    "compile": "npm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "watch:types": "tsc --noEmit --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "npm run compile && node --test test/unit/*.test.cjs",
    "test:integration": "npm run compile && node test/run-integration.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check",
    "package": "vsce package --readme-path MARKETPLACE.md --allow-missing-repository"
  },
  "devDependencies": {
    "@openpgp/web-stream-tools": "0.3.1",
    "@types/node": "22.20.5",
    "@types/vscode": ">=1.74.0 <1.147.0",
    "@vscode/vsce": "latest",
    "esbuild": "0.28.2",
    "prettier": "latest",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "modern-tar": "0.8.6",
    "openpgp": "6.3.3"
  }
}
