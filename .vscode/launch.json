{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Vaultual",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.cjs"],
      "preLaunchTask": "watch"
    },
    {
      "name": "Vaultual Integration Tests",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}/test/fixtures/workspace",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionTestsPath=${workspaceFolder}/test/integration/index.cjs",
        "--disable-extensions"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.cjs"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
